# Block everything by default
/*

# Unblock your configuration files and directories
!CLAUDE.md
!.gitignore

# .claude/ holds shared config; unblock it, reblock its contents,
# then unblock the specific files and directories we want tracked
!/.claude/
/.claude/*
!/.claude/.gitignore
!/.claude/settings.local.json
!/.claude/commands/
!/.claude/skills/
!/.claude/hooks/
!/.claude/agents/

# Block .DS_Store everywhere, even inside unblocked directories
.DS_Store
